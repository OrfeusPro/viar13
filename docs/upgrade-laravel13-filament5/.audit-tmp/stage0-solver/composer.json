{
    "name": "viarcanvas/stage0-core-solver",
    "description": "Isolated read-only migration solver; never used by the legacy application.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "livewire/livewire": "^4.0"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": false,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
