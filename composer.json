{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "viarcanvas/viar",
    "type": "project",
    "description": "ViarCanvas public application on Laravel 13.",
    "keywords": [
        "laravel",
        "viarcanvas"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "arrilot/laravel-widgets": "^3.15",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "bensampo/laravel-enum": "^6.14",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^13.20",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "mcamara/laravel-localization": "^2.4.1",
        "nesbot/carbon": "^3.10",
        "paypal/paypal-checkout-sdk": "^1.0.2",
        "predis/predis": "^3.5",
        "socialiteproviders/facebook": "^4.1",
        "spatie/laravel-medialibrary": "^11.23.5",
        "spatie/laravel-sluggable": "^4.0.3",
        "stevebauman/location": "^7.6.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "exclude-from-classmap": [
            "app/Http/Controllers/ContentTypes/Image.php",
            "app/Http/Controllers/vendor/voyager/Traits/Translatable.php"
        ],
        "files": [
            "app/Helpers/functions.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "TCG\\Voyager\\": "app/Compatibility/TCG/Voyager/"
        },
        "classmap": [
            "database/seeds"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "format": [
            "pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "mcamara/laravel-localization"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
