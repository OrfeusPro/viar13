{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3",
        "ext-json": "*",
        "arrilot/laravel-widgets": "^3.13",
        "barryvdh/laravel-dompdf": "^0.8.6",
        "barryvdh/laravel-translation-manager": "^0.5.10",
        "bensampo/laravel-enum": "^1.38",
        "davejamesmiller/laravel-breadcrumbs": "^5.3",
        "fideloper/proxy": "^4.0",
        "guzzlehttp/guzzle": "^7.3",
        "laravel/framework": "^6.2.0",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^1.2",
        "mcamara/laravel-localization": "^1.6",
        "monstrex/voyager-extension": "^0.95.2",
        "nesbot/carbon": "^2.36",
        "paypal/paypal-checkout-sdk": "^1.0",
        "predis/predis": "^1.1.1",
        "socialiteproviders/facebook": "^4.1",
        "spatie/laravel-sluggable": "^2.2",
        "stevebauman/location": "^6.2",
        "tcg/voyager": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "barryvdh/laravel-ide-helper": "^2.7",
        "facade/ignition": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.2",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^8.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
        }
      },
    "autoload": {
        "exclude-from-classmap": [
            "vendor\\tcg\\voyager\\src\\Http\\Controllers\\ContentTypes\\Image.php"
        ],
        "files": [
            "app/Helpers/functions.php",
            "app/Http/Controllers/ContentTypes/Image.php"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "format": [
            "vendor/bin/php-cs-fixer fix"
        ],
        "test": [
            "vendor/bin/phpunit"
        ]
    },
    "repositories": {

    }
}
